<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:gravity="center_vertical" android:text="拾课课程表" android:textSize="17sp" android:textStyle="bold" android:textColor="#263550" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="44dp" android:gravity="center" android:text="刷新" android:textSize="13sp" android:textColor="#456AB5" android:contentDescription="刷新课程小组件"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#687891" />
    <TextView android:id="@+id/widget_first" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textSize="13sp" android:textColor="#263550" android:visibility="gone"/>
    <TextView android:id="@+id/widget_second" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textSize="13sp" android:textColor="#263550" android:visibility="gone"/>
    <TextView android:id="@+id/widget_third" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textSize="13sp" android:textColor="#263550" android:visibility="gone"/>
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="近期没有课程 · 点此打开课表" android:textSize="13sp" android:textColor="#687891"/>
</LinearLayout>
