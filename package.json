{
  "name": "study-task-assistant",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-ocr.mjs && node scripts/prepare-voice.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-ocr.mjs && node scripts/prepare-voice.mjs && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check:release": "node scripts/validate-release.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "tesseract.js": "7.0.0",
    "vosk-browser": "0.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "fflate": "0.8.2",
    "vite": "8.3.5"
  }
}
